{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "StageScope: Doctor",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/setup-doctor.ps1"],
            "problemMatcher": [],
            "group": "none"
        },
        {
            "label": "StageScope: Build Debug APK",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"],
            "problemMatcher": ["$gradle"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "StageScope: Run Unit Tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1"],
            "problemMatcher": ["$gradle"],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "StageScope: Lint",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/lint.ps1"],
            "problemMatcher": ["$gradle"],
            "group": "none"
        },
        {
            "label": "StageScope: Install and Launch",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/install-launch.ps1"],
            "dependsOn": ["StageScope: Build Debug APK"],
            "problemMatcher": [],
            "group": "none"
        },
        {
            "label": "StageScope: Logs",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/logs.ps1"],
            "isBackground": true,
            "problemMatcher": [],
            "group": "none"
        }
    ]
}
