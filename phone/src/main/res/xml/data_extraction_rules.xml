<?xml version="1.0" encoding="utf-8"?>
<!-- No StageScope data (credentials, conversations, issues, drafts) is ever included in cloud
     backup or device-to-device transfer: provider keys are Keystore-bound and must not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
